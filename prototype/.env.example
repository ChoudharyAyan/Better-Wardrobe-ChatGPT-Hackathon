GEMINI_API_KEY=
# Legacy benchmark only. Production hackathon AI uses OpenAI.
GEMINI_MODEL=gemini-3-flash-preview
# Production uses OpenAI. Legacy provider switches are for local-only comparison.
VISION_PROVIDER=openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=20000
OPENAI_MODEL_MAX=gpt-5.4-mini
OPENAI_MODEL_LITE=gpt-5.4-nano
# Spend guard runs in memory per server instance. Use an OpenAI project hard cap for a global limit.
DECISIONS_MODEL=gpt-6-luna
DECISIONS_TIMEOUT_MS=4000
DECISIONS_MAX_INPUT_TOKENS=200000
DECISIONS_RANK=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b
OLLAMA_TIMEOUT_MS=180000
SERPAPI_API_KEY=
# auto: replay exact saved searches, otherwise run once and record. live: always call providers. replay: never call providers.
DISCOVERY_DATA_MODE=auto
DEVELOPER_DASHBOARD=false
# Public HTTPS URL pointing to this running server, required for Lens image retrieval.
PUBLIC_BASE_URL=https://sculptor-sliding-headlamp.ngrok-free.dev
# Shared preview cap: analyze/search operations per server hour (each may use multiple provider calls).
DISCOVERY_HOURLY_LIMIT=20

# Google Photos Picker: Web OAuth client ID (public identifier, not a secret).
# Enable Photos Picker API; add exact JS origins in Google Cloud. No client secret needed.
GOOGLE_PHOTOS_CLIENT_ID=

# Local development only: accept order batches from the Chrome extension in prototype/extension.
# Never set on Vercel (the server ignores it there anyway).
ORDER_CONNECTORS=false

# Discover search credits per guest: GPT-5.4 mini costs 15, nano 8.
DISCOVER_GUEST_CREDITS=120
# New users receive 50 bonus Discover credits, shown as XP in the Community wallet.
# Backstops for a shared preview: per network per day, and across all guests per day.
DISCOVER_IP_DAILY_CREDITS=360
DISCOVER_DAILY_CREDIT_CAP=600
# Signs search tickets. Set a long random value in production.
DISCOVER_TOKEN_SECRET=
# Legacy OpenRouter local benchmark setting.
OPENROUTER_MIN_BALANCE_USD=0.5

# Google sign-in (OAuth web client). Sign-in stays hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the tbw_session cookie. Set a long random value in production.
AUTH_SECRET=
# Neon Postgres for accounts, credits, chats and Community (Vercel Storage sets it).
POSTGRES_URL=
